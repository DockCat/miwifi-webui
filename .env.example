# miwifi-webui — environment example
# Copy to .env and adjust. These are DEVELOPMENT placeholders, not production values.

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=miwifi
POSTGRES_PASSWORD=miwifi-dev-password
POSTGRES_DB=miwifi
POSTGRES_PORT=5432

# --- API service (apps/api) ---
# Connection string used by the API and migrations. In local development the
# host is "localhost"; inside the compose network it would be "postgres".
DATABASE_URL=postgres://miwifi:miwifi-dev-password@localhost:5432/miwifi

# Master key for envelope-encrypting secrets at rest (router credentials).
# Generate: openssl rand -base64 32. Must decode to exactly 32 bytes.
# Stored OUTSIDE PostgreSQL, e.g. env var / container secret.
APP_MASTER_KEY=

# --- AI investigation (optional; disabled by default) ---
# Mode: "local" or "external" (unset => disabled). Requires BASE_URL + MODEL.
# Local: identifiers pass through; External: MAC/IP/names are pseudonymized
# unless explicitly allowed below.
AI_PROVIDER_MODE=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=
# External-egress data-category switches (true to allow; default false):
AI_EGRESS_ALLOW_MAC=
AI_EGRESS_ALLOW_IP=
AI_EGRESS_ALLOW_NAMES=

# HTTP port for the API service.
API_PORT=3001

# --- Web app (apps/web) ---
# Vite dev-server port.
WEB_PORT=5173
