# miwifi-webui — environment example
# Copy to .env and adjust. These are DEVELOPMENT placeholders, not production values.

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=miwifi
POSTGRES_PASSWORD=miwifi-dev-password
POSTGRES_DB=miwifi
POSTGRES_PORT=5432

# --- API service (apps/api) ---
# Connection string used by the API and migrations. In local development the
# host is "localhost"; inside the compose network it would be "postgres".
DATABASE_URL=postgres://miwifi:miwifi-dev-password@localhost:5432/miwifi

# Master key for envelope-encrypting secrets at rest (router credentials).
# Generate: openssl rand -base64 32. Must decode to exactly 32 bytes.
# Stored OUTSIDE PostgreSQL, e.g. env var / container secret.
APP_MASTER_KEY=

# --- AI investigation (optional; disabled by default) ---
# Mode: "local" or "external" (unset => disabled). Requires BASE_URL + MODEL.
# Local: identifiers pass through (endpoint is your own machine).
# External: MAC/IP/device names are ALWAYS pseudonymized before egress —
# the alias legend is stored with the investigation so findings stay readable.
AI_PROVIDER_MODE=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=

# --- Retention (days; defaults shown) ---
RETENTION_TELEMETRY_DAYS=90
RETENTION_PRESENCE_DAYS=365
RETENTION_AUDIT_DAYS=365
RETENTION_INVESTIGATION_DAYS=30

# HTTP port for the API service.
API_PORT=3001

# Trust X-Forwarded-* headers (request protocol/IP, cookie Secure flag).
# - false/unset: ignore forwarded headers (direct access).
# - Comma-separated proxy IP/CIDR list (RECOMMENDED behind a proxy): only
#   those peers are trusted as proxies, e.g. TRUST_PROXY=192.168.155.0/24
#   for the compose/Traefik network. request.ip then resolves to the first
#   hop beyond the proxy chain, so spoofed client entries are ignored.
# - true: trust EVERY forwarded claim from ANYONE. Only safe when no
#   untrusted client can reach the API port at all (not published).
# Note: the loopback-only first-run bootstrap always checks the real peer
# socket address, never forwarded headers, under any of these settings.
TRUST_PROXY=

# --- Web app (apps/web) ---
# Vite dev-server port.
WEB_PORT=5173
