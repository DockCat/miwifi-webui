{
  "name": "@miwifi-webui/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:create": "tsx src/cli/admin.ts create",
    "admin:reset-password": "tsx src/cli/admin.ts reset-password",
    "admin:create:dist": "node dist/cli/admin.js create",
    "admin:reset-password:dist": "node dist/cli/admin.js reset-password"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@miwifi-webui/contracts": "workspace:*",
    "@miwifi-webui/router-core": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
